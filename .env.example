# Database connection string
# Local development default port: 5432 (the docker-compose mapping)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightloop?sslmode=disable

# Port for the Go API server
PORT=8080

# Runtime and frontend origin
APP_ENV=development
APP_URL=http://localhost:3000
DB_MAX_CONNS=20

# Mailpit SMTP server for transactional emails
SMTP_ADDR=localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@brightloop.io

