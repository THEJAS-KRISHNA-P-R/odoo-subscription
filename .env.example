# Database connection string
# Local development default port: 5433 (or 5432 if using docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/brightloop?sslmode=disable

# Port for the Go API server
PORT=8080

# Mailpit SMTP server for transactional emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@brightloop.io

